<% layout('layouts/boilerplate') %>
<main class="form-page">
    <div class="auth-form-shell">
        <h2 class="text-center">Login to Wanderlust</h2>
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3"> 
                <label for="username" class="form-label">Username <span class="required-mark" aria-hidden="true">*</span></label>
          <input name="username" id="username" type="text" class="form-control" placeholder="Enter your username" autocomplete="username" required minlength="3">
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Username must be at least 3 characters.</div>
              </div>
            
              <div class="mb-3">
                <label for="password" class="form-label">Password <span class="required-mark" aria-hidden="true">*</span></label>
                <input name="password" id="password" type="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required minlength="6">
                <div class="valid-feedback">Strong password.</div>
                <div class="invalid-feedback">Password must be at least 6 characters.</div>
              </div>
            
              <button type="submit" class="btn btn-primary">Login</button>
              </form>
                <script>
                   (function () {
                'use strict'
    
                var forms = document.querySelectorAll('.needs-validation')
    
                Array.prototype.slice.call(forms)
                  .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                      if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                      }
    
                      form.classList.add('was-validated')
                    }, false)
                  })
              })()
                    </script>
                    <p class="mt-3">not have an account? <a href="/signup">signup here</a></p>
            
        </div>
              </main>