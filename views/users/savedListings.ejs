<% layout('layouts/boilerplate') %>

<main class="saved-page container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Saved Places</h1>
        <a href="/listings" class="btn btn-primary">Explore Listings</a>
    </div>

    <% if (listings.length) { %>
        <div class="row">
            <% listings.forEach((listing) => { %>
                <div class="col-lg-4 col-md-6 mb-4">
                    <article class="card listing-card h-100">
                        <a href="/listings/<%= listing._id %>">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy" onerror="this.onerror=null; this.src='/css/images/fallback-image.jpg';">
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5"><%= listing.title %></h2>
                            <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
                            <p class="card-text">₹<%= Number(listing.price).toLocaleString("en-IN") %> / night</p>
                            <a href="/listings/<%= listing._id %>" class="btn btn-outline-primary mt-auto">View Place</a>
                        </div>
                    </article>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <p>You have not saved any places yet.</p>
        <a href="/listings" class="btn btn-primary">Find a Place</a>
    <% } %>
</main>