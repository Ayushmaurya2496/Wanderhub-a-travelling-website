<% layout('layouts/boilerplate') %>

<main class="profile-page">
    <section class="profile-hero card listing-card">
        <div class="profile-hero-content">
            <div>
                <div>
                    <p class="text-muted mb-1">Your profile</p>
                    <h1 class="mb-2"><%= profileUser.username %></h1>
                    <p class="mb-0"><%= profileUser.email %></p>
                    <% if (profileUser.bio) { %>
                        <p class="mt-3 mb-0"><%= profileUser.bio %></p>
                    <% } %>
                </div>
                <div class="profile-inline-stats">
                    <div class="profile-inline-stat">
                        <strong class="d-block fs-4"><%= listings.length %></strong>
                        <span class="text-muted">Listings</span>
                    </div>
                    <div class="profile-inline-stat">
                        <strong class="d-block fs-4"><%= savedListings.length %></strong>
                        <span class="text-muted">Saved</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="profile-edit-card card listing-card">
        <div class="profile-card-content">
            <h2>Edit profile</h2>
            <form method="POST" action="/profile?_method=PUT" class="profile-edit-form needs-validation" novalidate>
                <div>
                    <label for="profile-username" class="form-label">Username</label>
                    <input id="profile-username" name="username" type="text" class="form-control" value="<%= profileUser.username %>" minlength="3" required>
                    <div class="invalid-feedback">Please enter a username.</div>
                </div>
                <div>
                    <label for="profile-email" class="form-label">Email</label>
                    <input id="profile-email" name="email" type="email" class="form-control" value="<%= profileUser.email %>" required>
                    <div class="invalid-feedback">Please enter a valid email.</div>
                </div>
                <div class="profile-bio-field">
                    <label for="profile-bio" class="form-label">Bio / About me</label>
                    <textarea id="profile-bio" name="bio" class="form-control" rows="4" maxlength="500" placeholder="Tell travellers a little about yourself"><%= profileUser.bio || "" %></textarea>
                    <div class="form-text">Maximum 500 characters.</div>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </section>

    <section class="profile-section">
        <div class="profile-section-heading">
            <h2 class="h4 mb-0">Your listings</h2>
            <a href="/listings/new" class="btn btn-primary">Add Listing</a>
        </div>
        <% if (listings.length) { %>
            <div class="profile-listings-grid">
                <% listings.forEach((listing) => { %>
                    <div class="profile-listing-item">
                        <article class="card listing-card h-100">
                            <a href="/listings/<%= listing._id %>">
                                <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy" onerror="this.onerror=null; this.src='/css/images/fallback-image.jpg';">
                            </a>
                            <div class="card-body d-flex flex-column p-3">
                                <h3 class="h5"><%= listing.title %></h3>
                                <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
                                <a href="/listings/<%= listing._id %>" class="btn btn-outline-primary mt-auto">View Listing</a>
                            </div>
                        </article>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p>You have not added any listings yet.</p>
        <% } %>
    </section>

    <section class="profile-section">
        <div class="profile-section-heading">
            <h2 class="h4 mb-0">Saved places</h2>
            <a href="/saved" class="btn btn-outline-primary">View All Saved</a>
        </div>
        <% if (savedListings.length) { %>
            <div class="profile-listings-grid">
                <% savedListings.slice(0, 3).forEach((listing) => { %>
                    <div class="profile-listing-item">
                        <article class="card listing-card h-100">
                            <a href="/listings/<%= listing._id %>">
                                <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy" onerror="this.onerror=null; this.src='/css/images/fallback-image.jpg';">
                            </a>
                            <div class="card-body p-3">
                                <h3 class="h5"><%= listing.title %></h3>
                                <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
                            </div>
                        </article>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p>You have not saved any places yet.</p>
        <% } %>
    </section>
</main>