<% layout('layouts/boilerplate') %>
<!-- CSS Styles of card -->
<style>
    .review-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 10px;
    }

    .review-card {
        background: #fcfcfd;
        border-radius: 8px;
        padding: 10px 15px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        min-width: 150px;
        max-width: 200px;
        flex: 1;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .review-card:hover {
        transform: scale(1.05);  
        box-shadow: 4px 4px 15px rgba(0, 0, 0, 0.2); 
        background: #eedf3e; 
    }

    .review-content {
        text-align: left;
    }

    .review-text {
        font-size: 14px;
        color: #333;
        margin-bottom: 6px;
    }

    .review-rating {
        font-size: 12px;
        font-weight: bold;
        color: #0cbaef;
    }
    .rating-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 12px 0 20px;
    }
    .rating-stars {
        color: #f4b400;
        letter-spacing: 2px;
    }
    .pending-review {
        border-left: 4px solid #f0ad4e;
    }
    .delete-btn {
        background-color: #dc3545; 
        color: white;
        border: none;
        padding: 8px 10px;
        font-size: 11px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease-in-out;
    }

  
    .delete-btn:hover {
        background-color: #f8051e; 
        transform: scale(1.1);
    }

 
    .delete-btn:active {
        transform: scale(0.95); 
    }
    .card-img-top{
        width: 80%;
    }
    
</style>

<body>
   
   
<div class="container listing-detail-page update-listing-form" style= "width: 100%;
                                                    max-width: 1300px;
                                                    min-width: 300px;
                                                    background-color: #f7f8fa;">  
      <h1> <%= listing.title %></h1>
            <% if (listing.category) { %>
                <p class="card-text"><strong>Category-</strong> <%= listing.category %></p>
            <% } %>
   <div class="card-img-top">
    <img src="<%= listing.image.url %>" class="listing-detail-image" alt="<%= listing.title %> Image" loading="lazy" onerror="this.onerror=null; this.src='/css/images/fallback-image.jpg';">
    </div> 
    <p class="card-text"><strong>By-</strong>
        <a href="/profile/showed/<%= listing.owner._id %>"><%= listing.owner.username %></a>
    </p>
    <p class="card-text"><%= listing.description %></p>
    <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
    <p class="card-text"><strong>Location-</strong><%= listing.location %></p>
    <p class="card-text"><strong>Country-</strong><%= listing.country %></p>
    <% if (currentUser) { %>
        <% if (isSaved) { %>
            <form method="POST" action="/saved/<%= listing._id %>?_method=DELETE">
                <button type="submit" class="btn btn-outline-danger">Remove from Saved</button>
            </form>
        <% } else { %>
            <form method="POST" action="/saved/<%= listing._id %>">
                <button type="submit" class="btn btn-outline-primary">Save to Wishlist</button>
            </form>
        <% } %>
    <% } %>
    <div class="rating-summary" aria-label="Average rating <%= averageRating.toFixed(1) %> out of 5">
        <span class="rating-stars"><%= "★".repeat(Math.round(averageRating)) %><%= "☆".repeat(5 - Math.round(averageRating)) %></span>
        <strong><%= averageRating ? averageRating.toFixed(1) : "No rating" %></strong>
        <span>(<%= approvedReviewCount %> approved reviews)</span>
    </div>
   
    <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>
        <br>
        <hr>
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">UPDATE DETAILS</a>
        <br>
        <hr>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button type="submit" class="btn btn-primary">Delete Listing</button>
        </form>
    <% } %>
    
    <div class="container update-listing-form">
        <hr>
        <h4>LEAVE A REVIEW</h4>
        <% if(currentUser){ %>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" class="needs-validation" novalidate>
          
            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>




            
            <div>
                <label for="comment"></label>
                <textarea name="review[comment]"
                          id="comment"
                          placeholder="Comment Here??" 
                          cols="60" rows="8"
                          class="form-control"
                          required></textarea>
                <div class="invalid-feedback">Please add some comment</div>
            </div>
        
            <button class="btn btn-primary" type="submit">
                Submit
            </button>
        </form>
        <% } %>
        <hr>
        <h4>All Reviews</h4>
        <hr>
        <div class="review-container">
            <% if(listing.reviews.length > 0) { %>
                <% for(let review of listing.reviews) { %>
                    <% const isApproved = review.status === "approved" || !review.status; %>
                    <% const isListingOwner = currentUser && listing.owner && currentUser._id.equals(listing.owner._id); %>
                    <% if (isApproved || isListingOwner) { %>
                    <div class="review-card <%= isApproved ? '' : 'pending-review' %>">
                        <div class="review-content">
                            <% if (review.author && review.author.username) { %>
                                <h5 class="review-text" style="word-wrap: break-word; overflow-wrap: break-word;">By- @<a href="/profile/showed/<%= review.author._id %>"><%= review.author.username %></a></h5>
                            <% } else { %>
                                <h5 class="review-text">Anonymous</h5>
                            <% } %>
        
                            
                            
                            

                                                        <p class="starability-result" data-rating="<%= review.rating %>" aria-label="Rated <%= review.rating %> out of 5">
                                                                Rated: <%= review.rating %> stars
                              </p>
                                                            <% if (!isApproved) { %><p class="text-warning"><strong>Pending moderation</strong></p><% } %>
                              <p class="card">
                                <%= review.comment %>
                            </p>
                        </div>
                       
  
        
                        <% if (isListingOwner && !isApproved) { %>
                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>/approve?_method=PUT">
                                <button class="btn btn-success btn-sm">Approve</button>
                            </form>
                        <% } %>
                        <% if (currentUser && (isListingOwner || (review.author && currentUser._id.equals(review.author._id)))) { %>
                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="delete-btn">Delete</button>
                            </form>
                        <% } %>
                    </div>
                    <% } %>
                <% } %>
            <% } else { %>
                <p>No Reviews yet. Be the first to Review!</p>
            <% } %>
        </div>
        
        <hr>
        
        
    </div>
    
</div>
<script>
    (() => {
      'use strict';
      const forms = document.querySelectorAll('.needs-validation');
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    })();
    </script>
    
</body>

