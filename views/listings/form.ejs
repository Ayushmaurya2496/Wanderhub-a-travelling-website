<% layout('layouts/boilerplate') %>
<main class="form-page">
<div class="add-listing-form">
    <form method="POST" action="/listings" novalidate class="needs-validation"  enctype="multipart/form-data">
      <div class="form-group mb-3">
            <label for="category">Category <span class="required-mark" aria-hidden="true">*</span></label>
        <select id="category" name="category" class="form-select" required>
          <option value="" selected disabled>Select a category</option>
          <option value="None">None</option>
          <option>Beaches</option>
          <option>Mountains</option>
          <option>Hill Stations</option>
          <option>Historical Places</option>
          <option>Heritage Sites</option>
          <option>Religious Places</option>
          <option>Museums</option>
          <option>Wildlife Sanctuaries</option>
          <option>National Parks</option>
          <option>Waterfalls</option>
          <option>Lakes</option>
          <option>Rivers</option>
          <option>Islands</option>
          <option>Deserts</option>
          <option>Adventure Activities</option>
          <option>Amusement Parks</option>
          <option>Cultural Attractions</option>
          <option>Shopping Places</option>
          <option>Food and Dining</option>
          <option>Eco-Tourism</option>
          <option>Family Destinations</option>
          <option>Romantic Getaways</option>
          <option>Photography Spots</option>
          <option>Camping Sites</option>
          <option>Wellness and Spa</option>
          <option>Offbeat Destinations</option>
        </select>
        <div class="invalid-feedback">Please select a category.</div>
      </div>

        <div class="form-group mb-3">
            <label for="title">Title <span class="required-mark" aria-hidden="true">*</span></label>
            <input type="text" id="title" name="title" placeholder="Enter title" minlength="3" maxlength="50" class="form-control" required>
            <div class="invalid-feedback">Title must be between 3 to 50 characters.</div>
        </div>

        <div class="form-group mb-3">
            <label for="description">Description <span class="required-mark" aria-hidden="true">*</span></label>
            <textarea id="description" name="description" placeholder="Enter description" minlength="10" maxlength="300" class="form-control" required></textarea>
            <div class="invalid-feedback">Description must be between 10 to 300 characters.</div>
        </div>

       


        <div class="form-group mb-3">
          <label for="image">Upload Image <span class="required-mark" aria-hidden="true">*</span></label>
          <label for="image" class="image-upload-zone" id="image-upload-zone">
            <span class="upload-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7 9m5-5 5 5M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path></svg>
            </span>
            <span class="upload-copy">
              <strong>Drag &amp; drop an image here</strong>
              <span>or <em>Browse files</em></span>
              <small>PNG, JPG up to 5MB</small>
            </span>
            <input type="file" id="image" name="listing[image]" accept="image/png,image/jpeg,image/jpg" required>
          </label>
          <div class="image-preview" id="image-preview" aria-live="polite"></div>
          <div class="invalid-feedback">Please select a PNG or JPG image up to 5MB.</div>
      </div> 

        <div class="form-group mb-3">
            <label for="price">Price <span class="required-mark" aria-hidden="true">*</span></label>
            <div class="price-input-group">
              <span class="currency-prefix" aria-hidden="true">₹</span>
              <input type="number" id="price" name="price" placeholder="Enter price" min="0.01" max="1000000" step="0.01" inputmode="decimal" class="form-control" required>
            </div>
            <div class="invalid-feedback">Price must be greater than 0.</div>
        </div>

        <div class="form-group mb-3">
            <label for="country">Country <span class="required-mark" aria-hidden="true">*</span></label>
            <input type="text" id="country" name="country" placeholder="Enter country" minlength="2" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid country name.</div>
        </div>

        <div class="form-group mb-3">
            <label for="location">Location <span class="required-mark" aria-hidden="true">*</span></label>
            <input type="text" id="location" name="location" placeholder="Enter location" minlength="2" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid location.</div>
        </div>

        <button type="submit" class="btn create-listing-btn">
          <span class="create-listing-label">Create Listing</span>
          <span class="create-listing-loading" hidden>Creating...</span>
        </button>
    </form>
</div>
</main>

<script>
(() => {
  'use strict';
  const forms = document.querySelectorAll('.needs-validation');
  Array.from(forms).forEach(form => {
    form.addEventListener('submit', event => {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
})();
</script>
<script>
(() => {
  const uploadZone = document.querySelector('#image-upload-zone');
  const imageInput = document.querySelector('#image');
  const preview = document.querySelector('#image-preview');
  if (!uploadZone || !imageInput || !preview) return;

  const maxFileSize = 5 * 1024 * 1024;
  const acceptedTypes = ['image/png', 'image/jpeg', 'image/jpg'];

  const showPreview = (file) => {
    if (!acceptedTypes.includes(file.type) || file.size > maxFileSize) {
      imageInput.value = '';
      preview.className = 'image-preview upload-error';
      preview.textContent = 'Use a PNG or JPG image smaller than 5MB.';
      return;
    }

    const reader = new FileReader();
    reader.addEventListener('load', () => {
      preview.className = 'image-preview has-preview';
      preview.innerHTML = `<img src="${reader.result}" alt="Selected image preview"><span>${file.name}</span>`;
    });
    reader.readAsDataURL(file);
  };

  imageInput.addEventListener('change', () => {
    if (imageInput.files[0]) showPreview(imageInput.files[0]);
  });

  ['dragenter', 'dragover'].forEach((eventName) => {
    uploadZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      uploadZone.classList.add('is-dragging');
    });
  });

  ['dragleave', 'drop'].forEach((eventName) => {
    uploadZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      uploadZone.classList.remove('is-dragging');
    });
  });

  uploadZone.addEventListener('drop', (event) => {
    const file = event.dataTransfer.files[0];
    if (!file) return;
    const transfer = new DataTransfer();
    transfer.items.add(file);
    imageInput.files = transfer.files;
    showPreview(file);
  });
})();
</script>
<script>
(() => {
  const form = document.querySelector('.add-listing-form form');
  const submitButton = form?.querySelector('.create-listing-btn');
  if (!form || !submitButton) return;

  form.addEventListener('submit', (event) => {
    if (!form.checkValidity()) return;
    submitButton.disabled = true;
    submitButton.querySelector('.create-listing-label').hidden = true;
    submitButton.querySelector('.create-listing-loading').hidden = false;
    submitButton.setAttribute('aria-busy', 'true');
  });
})();
</script>
