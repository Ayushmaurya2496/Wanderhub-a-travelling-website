<header>
    <style>
        .user-container {
            display: inline-flex;
            align-items: center;
            min-height: 30px;
            padding: 4px 8px;
            background-color: rgb(86, 86, 102);
            border-radius: 10px;
            white-space: nowrap;
        }

        .user-container span {
            color: rgb(236, 237, 238);
            font-size: 12px;
            font-weight: bold;
            line-height: 1.2;
        }
    </style>

    <div class="header-container">
        <div class="header-top-row">
            <div class="logo">
                <a href="/">Wanderlust</a>
            </div>
            <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-navigation">
                <span></span><span></span><span></span>
            </button>
        </div>

        <div class="header-menu" id="main-navigation">
            <nav class="nav-links">
                <ul>
                    <li><a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a></li>
                    <li><a class="<%= currentPath.startsWith('/listings') ? 'active' : '' %>" href="/listings">Listings</a></li>
                    <li><a class="<%= currentPath === '/about' ? 'active' : '' %>" href="/about">About Us</a></li>
                    <li><a class="<%= currentPath === '/contact' ? 'active' : '' %>" href="/contact">Contact Us</a></li>
                </ul>
            </nav>

            <div class="search-bar">
                <form action="/search" method="GET">
                    <input type="search" name="q" placeholder="Search destinations..." aria-label="Search destinations" required>
                    <button type="submit" aria-label="Search">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
                    </button>
                </form>
            </div>

            <div class="header-actions">
                <div class="cta">
                    <a href="/listings/new" class="btn">Add Listing</a>
                </div>
                <div class="auth-buttons">
                    <% if (currentUser) { %>
                        <a href="/logout" class="btn btn-outline-danger">Logout</a>
                        <div class="user-container">
                            <a href="/profile/showed" class="text-decoration-none">
                                <span><%= currentUser.username %></span>
                            </a>
                        </div>
                    <% } else { %>
                        <a href="/signup" class="btn signup-btn">Signup</a>
                        <a href="/login" class="btn login-btn">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    (() => {
        const menuButton = document.querySelector('.menu-toggle');
        const menu = document.querySelector('#main-navigation');
        if (!menuButton || !menu) return;
        menuButton.addEventListener('click', () => {
            const isOpen = menu.classList.toggle('is-open');
            menuButton.setAttribute('aria-expanded', String(isOpen));
            menuButton.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
        });
    })();
</script>
